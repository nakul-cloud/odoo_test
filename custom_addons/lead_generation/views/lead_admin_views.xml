<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- API Tokens -->
        <record id="lead_api_token_tree" model="ir.ui.view">
            <field name="name">lead.api.token.tree</field>
            <field name="model">lead.api.token</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="scopes"/>
                    <field name="is_active"/>
                    <field name="expires_at"/>
                    <field name="last_used"/>
                    <field name="api_calls_count"/>
                </list>
            </field>
        </record>

        <record id="lead_api_token_form" model="ir.ui.view">
            <field name="name">lead.api.token.form</field>
            <field name="model">lead.api.token</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="scopes"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="token" widget="password" readonly="1"/>
                            <field name="expires_at"/>
                            <field name="last_used"/>
                            <field name="api_calls_count"/>
                        </group>
                        <group>
                            <field name="ip_whitelist"/>
                            <field name="rate_limit"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_lead_api_tokens" model="ir.actions.act_window">
            <field name="name">API Tokens</field>
            <field name="res_model">lead.api.token</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Webhooks -->
        <record id="lead_webhook_tree" model="ir.ui.view">
            <field name="name">lead.webhook.tree</field>
            <field name="model">lead.webhook</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="url"/>
                    <field name="event_type"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="lead_webhook_form" model="ir.ui.view">
            <field name="name">lead.webhook.form</field>
            <field name="model">lead.webhook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="event_type"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="secret"/>
                            <field name="headers"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_lead_webhooks" model="ir.actions.act_window">
            <field name="name">Webhooks</field>
            <field name="res_model">lead.webhook</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Activity Logs -->
        <record id="lead_activity_tree" model="ir.ui.view">
            <field name="name">lead.activity.tree</field>
            <field name="model">lead.activity</field>
            <field name="arch" type="xml">
                <list>
                    <field name="lead_id"/>
                    <field name="activity_type"/>
                    <field name="description"/>
                    <field name="field_name"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="action_lead_activity_logs" model="ir.actions.act_window">
            <field name="name">Activity Logs</field>
            <field name="res_model">lead.activity</field>
            <field name="view_mode">list</field>
        </record>

        <!-- Menu Items (Admin) -->
        <menuitem id="menu_lead_generation_admin" name="API Settings"
                  parent="menu_lead_generation_root" sequence="60" groups="base.group_system"/>

        <menuitem id="menu_lead_api_tokens" name="API Tokens"
                  parent="menu_lead_generation_admin" action="action_lead_api_tokens"
                  sequence="10" groups="base.group_system"/>

        <menuitem id="menu_lead_webhooks" name="Webhooks"
                  parent="menu_lead_generation_admin" action="action_lead_webhooks"
                  sequence="20" groups="base.group_system"/>

        <menuitem id="menu_lead_activity_logs" name="Activity Logs"
                  parent="menu_lead_generation_admin" action="action_lead_activity_logs"
                  sequence="30" groups="base.group_system"/>
    </data>
</odoo>
