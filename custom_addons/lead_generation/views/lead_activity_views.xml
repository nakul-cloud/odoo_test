<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lead_activity_tree" model="ir.ui.view">
            <field name="name">lead.activity.tree</field>
            <field name="model">lead.activity</field>
            <field name="arch" type="xml">
                <list>
                    <field name="lead_id"/>
                    <field name="activity_type"/>
                    <field name="description"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="lead_activity_form" model="ir.ui.view">
            <field name="name">lead.activity.form</field>
            <field name="model">lead.activity</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="lead_id"/>
                            <field name="activity_type"/>
                            <field name="description"/>
                            <field name="user_id"/>
                            <field name="field_name"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="api_token_id"/>
                            <field name="create_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_lead_activity" model="ir.actions.act_window">
            <field name="name">Activity Log</field>
            <field name="res_model">lead.activity</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_lead_activity" name="Activity Log"
                  parent="menu_lead_generation_root"
                  action="action_lead_activity"
                  sequence="30"/>
    </data>
</odoo>
