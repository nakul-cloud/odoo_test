<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="lead_webhook_tree" model="ir.ui.view">
            <field name="name">lead.webhook.tree</field>
            <field name="model">lead.webhook</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="url"/>
                    <field name="event_type"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="lead_webhook_form" model="ir.ui.view">
            <field name="name">lead.webhook.form</field>
            <field name="model">lead.webhook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="url" widget="url"/>
                            <field name="event_type"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="secret" password="True"/>
                            <field name="headers"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_lead_webhook" model="ir.actions.act_window">
            <field name="name">Webhooks</field>
            <field name="res_model">lead.webhook</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_lead_webhook" name="Webhooks"
                  parent="menu_lead_generation_root"
                  action="action_lead_webhook"
                  sequence="40"/>
    </data>
</odoo>
